#include <iostream>
#include <iomanip>
#include <cstdlib>
#include <ctime>

using namespace std;

// --- Прототипи функцій ---
bool isMatch(int x);
void generateRec(int* c, int size, int low, int high, int i = 0);
void printRec(const int* c, int size, int i = 0);
int countRec(const int* c, int size, int i = 0);
int sumRec(const int* c, int size, int i = 0);
void replaceRec(int* c, int size, int i = 0);

int main() {
    srand((unsigned)time(0));
    const int SIZE = 27;
    int c[SIZE];

    generateRec(c, SIZE, -35, 25);

    cout << "Initial array:\n";
    printRec(c, SIZE);

    cout << "\nCount = " << countRec(c, SIZE)
        << "\nSum = " << sumRec(c, SIZE) << "\n\nModified array:\n";

    replaceRec(c, SIZE);
    printRec(c, SIZE);

    return 0;
}

// --- Реалізація функцій ---
bool isMatch(int x) {
    return (x > 0) || (x % 2 != 0);
}

void generateRec(int* c, int size, int low, int high, int i) {
    if (i >= size) return;
    c[i] = low + rand() % (high - low + 1);
    generateRec(c, size, low, high, i + 1);
}

void printRec(const int* c, int size, int i) {
    if (i >= size) { cout << endl; return; }
    cout << setw(4) << c[i];
    printRec(c, size, i + 1);
}

int countRec(const int* c, int size, int i) {
    if (i >= size) return 0;
    return (isMatch(c[i]) ? 1 : 0) + countRec(c, size, i + 1);
}

int sumRec(const int* c, int size, int i) {
    if (i >= size) return 0;
    return (isMatch(c[i]) ? c[i] : 0) + sumRec(c, size, i + 1);
}

void replaceRec(int* c, int size, int i) {
    if (i >= size) return;
    if (isMatch(c[i])) c[i] = 0;
    replaceRec(c, size, i + 1);
}


